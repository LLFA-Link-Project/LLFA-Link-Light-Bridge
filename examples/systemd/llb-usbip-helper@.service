[Unit]
Description=LLFA Bridge USB/IP helper (%i)

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/llb-usbip-helper serve /etc/llfa-link-light-bridge/%i.json
RuntimeDirectory=llfa-link-light-bridge
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
StateDirectory=llfa-link-light-bridge
StateDirectoryMode=0700
NoNewPrivileges=yes
Restart=no

[Install]
WantedBy=multi-user.target
